# Local-only defaults. Copy to .env and change secrets before exposing any port.
OMF_API_KEY=change-me
OMF_DATA_DIR=/app/data
OMF_ALLOWED_MEDIA_ROOTS=/app/data/inbox,/app/data/output,/app/data/archive
OMF_PUBLISH_MODE=dry-run
OMF_STORE_BACKEND=postgres
OMF_SCHEDULER_ENABLED=true
OMF_SCHEDULER_TICK_SECONDS=15
OMF_AUTOMATION_MAX_ATTEMPTS=3
OMF_SCHEDULER_TIMEZONE=Asia/Shanghai

# Generative media is a separate capability layer. Keep disabled until the
# native ComfyUI runtime and workflow models are installed and verified.
OMF_MEDIA_GENERATION_ENABLED=false
OMF_MEDIA_VIDEO_PROVIDER=comfyui
OMF_MEDIA_IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_OUTPUT_DIR=/app/data/inbox/generated/comfyui
COMFYUI_IMAGE_WORKFLOW=/app/config/workflows/image.json
COMFYUI_VIDEO_WORKFLOW=/app/config/workflows/video.json
COMFYUI_VIDEO_I2V_WORKFLOW=/app/config/workflows/video_i2v.json
# Complete the one-time Desktop setup under data/comfyui, then use
# ./scripts/start-comfyui.sh so generated files land under data/inbox.
LOCAL_MEDIA_RUNTIME_BASE_URL=http://host.docker.internal:8090
# Empty means reuse OMF_API_KEY.
LOCAL_MEDIA_RUNTIME_API_KEY=
LOCAL_MEDIA_RUNTIME_PORT=8090
OMF_LIP_SYNC_ENABLED=false
OMF_LIP_SYNC_BASE_URL=http://host.docker.internal:8090
OMF_MUSETALK_BASE_URL=http://127.0.0.1:8091
OMF_MUSETALK_PORT=8091
OMF_MUSETALK_RUNTIME=
MUSETALK_BATCH_SIZE=4
MUSETALK_EXTRA_MARGIN=6
MUSETALK_PARSING_MODE=jaw
MUSETALK_LEFT_CHEEK_WIDTH=60
MUSETALK_RIGHT_CHEEK_WIDTH=60
MUSETALK_UPPER_BOUNDARY_RATIO=0.55
MUSETALK_TEMPORAL_SMOOTHING=0.12
# Empty means reuse LOCAL_MEDIA_RUNTIME_API_KEY or OMF_API_KEY.
OMF_LIP_SYNC_API_KEY=
OMF_LIP_SYNC_FALLBACK_TO_NARRATION=true
OMF_LIP_SYNC_MIN_SCORE=0.65
OMF_LIP_SYNC_MIN_FACE_COVERAGE=0.80
OMF_TTS_PROVIDER=qwen3-mlx
OMF_TTS_MODEL_PATH=
OMF_TTS_VOICE=Vivian
OMF_TTS_LANGUAGE=Chinese
OMF_TTS_INSTRUCT=自然、有感染力的中文短视频旁白，语气亲切，节奏有停顿，避免播音腔
OMF_FRAME_INTERPOLATION_ENABLED=true
OMF_FRAME_INTERPOLATION_MULTIPLIER=2
OMF_RIFE_WEIGHTS_DIR=

# Primary: local llama.cpp serving the official Qwen GGUF downloaded from Hugging Face.
LLM_PRIMARY_BASE_URL=http://host.docker.internal:8081/v1
LLM_PRIMARY_MODEL=Qwen/Qwen3-14B-GGUF:Q4_K_M
LLM_PRIMARY_API_KEY=local
LLM_PRIMARY_ENABLE_THINKING=false
LLM_PRIMARY_ATTEMPTS=2
LLM_REQUEST_TIMEOUT_SECONDS=120

# Cloud fallback is opt-in. The key must stay in .env and must never enter task data.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_ENABLE_THINKING=
LLM_FALLBACK_REVIEW_MIN_SCORE=70
LLM_FALLBACK_REVIEW_MAX_SCORE=84

# Optional OpenRouter privacy constraints, applied only to openrouter.ai requests.
OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny

# Built-in video engine service. The Compose network resolves this name automatically.
MPT_BASE_URL=http://video-engine:8080
MPT_HOST_PORT=8082
MPT_API_KEY=
MPT_OUTPUT_DIR=/app/data/output/video-engine
REDIS_URL=redis://redis:6379/0

POSTGRES_DB=open_media_flow
POSTGRES_USER=open_media_flow
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=open_media_flow
MINIO_ROOT_PASSWORD=change-me-minio

# Publishing is deliberately disabled until account authorization is configured.
SOCIAL_AUTO_UPLOAD_DIR=/opt/social-auto-upload
